{
  "name": "tile-logistics",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "USE_LOCAL_DATABASE=true next dev -H 127.0.0.1",
    "dev:local": "USE_LOCAL_DATABASE=true next dev -H 127.0.0.1",
    "dev:turso": "USE_LOCAL_DATABASE=false next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "esbuild scripts/seed.ts --bundle --platform=node --format=cjs --outfile=.tmp/seed.cjs --external:@libsql/client --external:fs --external:path --external:crypto && DB_TARGET=turso node .tmp/seed.cjs",
    "seed:local": "esbuild scripts/seed.ts --bundle --platform=node --format=cjs --outfile=.tmp/seed.cjs --external:@libsql/client --external:fs --external:path --external:crypto && DB_TARGET=local node .tmp/seed.cjs",
    "seed:reports": "esbuild scripts/seed-report-orders.ts --bundle --platform=node --format=cjs --outfile=.tmp/seed-reports.cjs --external:@libsql/client --external:fs --external:path --external:crypto && DB_TARGET=turso node .tmp/seed-reports.cjs",
    "seed:reports:local": "esbuild scripts/seed-report-orders.ts --bundle --platform=node --format=cjs --outfile=.tmp/seed-reports.cjs --external:@libsql/client --external:fs --external:path --external:crypto && DB_TARGET=local node .tmp/seed-reports.cjs",
    "delete:report-orders": "esbuild scripts/delete-report-test-orders.ts --bundle --platform=node --format=cjs --outfile=.tmp/delete-report-orders.cjs --external:@libsql/client --external:fs --external:path --external:crypto && DB_TARGET=turso node .tmp/delete-report-orders.cjs",
    "delete:report-orders:local": "esbuild scripts/delete-report-test-orders.ts --bundle --platform=node --format=cjs --outfile=.tmp/delete-report-orders.cjs --external:@libsql/client --external:fs --external:path --external:crypto && DB_TARGET=local node .tmp/delete-report-orders.cjs",
    "reset": "npm run reset:turso",
    "reset:turso": "esbuild scripts/reset-data.ts --bundle --platform=node --format=cjs --outfile=.tmp/reset.cjs --external:@libsql/client --external:fs --external:path --external:crypto && DB_TARGET=turso env -u USE_LOCAL_DATABASE node .tmp/reset.cjs",
    "reset:turso:cli": "chmod +x scripts/setup-turso.sh && ./scripts/setup-turso.sh --wipe",
    "reset:local": "esbuild scripts/reset-data.ts --bundle --platform=node --format=cjs --outfile=.tmp/reset.cjs --external:@libsql/client --external:fs --external:path --external:crypto && DB_TARGET=local node .tmp/reset.cjs",
    "reset:all": "npm run reset:turso && npm run reset:local",
    "turso:info": "chmod +x scripts/setup-turso.sh && ./scripts/setup-turso.sh --info",
    "turso:apply-schema": "esbuild scripts/apply-turso-schema.ts --bundle --platform=node --format=cjs --outfile=.tmp/apply-schema.cjs --external:@libsql/client --external:fs --external:path --external:crypto && node .tmp/apply-schema.cjs --turso",
    "turso:apply-schema:local": "esbuild scripts/apply-turso-schema.ts --bundle --platform=node --format=cjs --outfile=.tmp/apply-schema.cjs --external:@libsql/client --external:fs --external:path --external:crypto && node .tmp/apply-schema.cjs --local",
    "sync:locations": "esbuild scripts/sync-warehouse-locations.ts --bundle --platform=node --format=cjs --outfile=.tmp/sync-locations.cjs --external:better-sqlite3 --external:@libsql/client --external:fs --external:path && node .tmp/sync-locations.cjs",
    "watch:invoices": "esbuild scripts/watch-invoice-folder.ts --bundle --platform=node --format=cjs --outfile=.tmp/watch-invoices.cjs --external:@libsql/client --external:fs --external:path --external:os --external:crypto && node .tmp/watch-invoices.cjs --local",
    "watch:invoices:turso": "esbuild scripts/watch-invoice-folder.ts --bundle --platform=node --format=cjs --outfile=.tmp/watch-invoices.cjs --external:@libsql/client --external:fs --external:path --external:os --external:crypto && node .tmp/watch-invoices.cjs --turso",
    "refresh:import-queue": "esbuild scripts/refresh-import-queue.ts --bundle --platform=node --format=cjs --outfile=.tmp/refresh-import-queue.cjs --external:@libsql/client --external:fs --external:path --external:os --external:crypto && node .tmp/refresh-import-queue.cjs --local",
    "refresh:import-queue:turso": "esbuild scripts/refresh-import-queue.ts --bundle --platform=node --format=cjs --outfile=.tmp/refresh-import-queue.cjs --external:@libsql/client --external:fs --external:path --external:os --external:crypto && node .tmp/refresh-import-queue.cjs --turso",
    "test:prodata-api": "tsx scripts/test-prodata-api.ts",
    "prodata:login": "tsx scripts/prodata-login.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "heic2any": "^0.0.4",
    "html5-qrcode": "^2.3.8",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.9",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-map-gl": "^8.1.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
